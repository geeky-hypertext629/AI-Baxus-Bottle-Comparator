{
  "manifest_version": 3,
  "name": "Website AI Assistant",
  "version": "1.0",
  "description": "Scrape website content and ask Gemini AI questions about it",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.googleapis.com/*","https://services.baxus.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
